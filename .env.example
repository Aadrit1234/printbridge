[TEMPLATE]
# Copy to .env and adjust if needed
PORT=8088
HOST=0.0.0.0
# LOG_LEVEL=info
# DATA_DIR=./data

# ---------------------------------------------------------------------------
# The console's own sign-in
# ---------------------------------------------------------------------------
# The desktop apps ask for a username and a password. Unset, a username of
# "admin" and a random password are generated on first run and printed in the
# startup banner; whoever sets the machine reads them off that screen and
# changes them in the app under Access.
#
# A password is at least 6 characters. Set these when you are provisioning a
# machine you are not sitting in front of — a shop's PC you set up once and
# leave running.
# ADMIN_USER=admin
# ADMIN_PASSWORD=change-me-to-a-real-password

# The old name for ADMIN_PASSWORD, still honoured: an install that has a PIN
# keeps signing in with it, as the password of "admin".
# ADMIN_PIN=123456

# ---------------------------------------------------------------------------
# Owner accounts and licences
# ---------------------------------------------------------------------------
# The operator key is *your* key as the vendor, not a customer's. It is what
# mints the access codes a licence is sold as (POST /api/owner/codes), and it
# is the only way an account can be created: a customer redeems a code at
# /owner and the account inherits the plan that code carried.
#
# There is no default and no first-run generation on purpose — a guessable
# vendor key would be worse than no key at all. 16+ characters; unset means
# nobody can issue a code.
# OPERATOR_KEY=change-me-to-a-long-random-string

# Only needed when the public sites are hosted somewhere other than this
# machine (Vercel, Netlify). Comma-separated exact origins.
# ALLOWED_ORIGINS=https://your-project.vercel.app

# ---------------------------------------------------------------------------
# Selling: the checkout, the licence email and the downloads
# ---------------------------------------------------------------------------
# Where the website lives — it goes in the licence email so a buyer knows where
# to redeem the code.
# PUBLIC_URL=https://print-pi-three.vercel.app

# How a buyer pays. The checkout shows whatever is set here and records the
# order; you mark it paid from the order desk (`npm run orders paid PB-2026-0001`)
# and the access code is minted and emailed in that one step. Nothing here ever
# invents account details: with none of it set, the checkout tells the buyer to
# get in touch and you send them payment details yourself.
# PAYMENT_UPI=yourname@upi
# PAYMENT_PAYEE=PrintBridge
# PAYMENT_BANK=Account name, number, IFSC
# PAYMENT_NOTE=Anything else the buyer should see at checkout

# Mail. Without credentials nothing is lost: the licence email is written to
# data/mail-outbox/<time>-<address>.txt, and the order desk prints the path.
# With MAIL_API_KEY + MAIL_FROM it goes out through Resend; with a webhook it is
# POSTed as JSON to any relay you run.
# MAIL_FROM=PrintBridge <licences@yourdomain.com>
# MAIL_API_KEY=re_xxxxxxxx
# MAIL_WEBHOOK_URL=https://example.com/incoming-mail
# MAIL_WEBHOOK_SECRET=whatever-your-relay-checks

# Where the installers are published. The owner page links to a release asset
# named after this version, e.g. .../releases/download/v3.1.0/PrintBridge-Workspace-Setup-3.1.0.exe
# RELEASES_REPO=Aadrit1234/printbridge
# RELEASES_BASE=https://downloads.yourdomain.com/3.1.0
